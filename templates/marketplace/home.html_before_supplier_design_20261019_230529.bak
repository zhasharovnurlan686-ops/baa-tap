
{% extends 'base.html' %}
{% block title %}BaaTap KG — находите поставщиков{% endblock %}
{% block content %}

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Кыргызстандагы жеке бизнес үчүн
        {% else %}
          Для частного бизнеса Кыргызстана
        {% endif %}
      </div>

      <h1>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Биз жеткирүүчүлөргө жана сатып алуучуларга <span>бири-бирин табууга жардам беребиз.</span>
        {% else %}
          Мы помогаем поставщикам и <span>покупателям найти друг друга.</span>
        {% endif %}
      </h1>

      <p>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Бир коммерциялык суроо-талап түзүңүз. Сунуштарды алып, бааларды жана шарттарды салыштырыңыз.
        {% else %}
          Опубликуйте коммерческий запрос, получите предложения и сравните цены и условия поставщиков.
        {% endif %}
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="{% url 'request_create' %}">
          {% if request.LANGUAGE_CODE == 'ky' %}Суроо-талап түзүү{% else %}Создать запрос{% endif %}
          <span>→</span>
        </a>
        <a class="btn btn-secondary" href="{% url 'request_list' %}">
          {% if request.LANGUAGE_CODE == 'ky' %}Суроо-талаптарды көрүү{% else %}Смотреть запросы{% endif %}
        </a>
      </div>

      <div class="hero-note">
        <span class="checkmark">✓</span>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Акысыз катталуу · Түз байланыш
        {% else %}
          Бесплатная регистрация · Общение напрямую
        {% endif %}
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-orbit orbit-one"></div>
      <div class="visual-orbit orbit-two"></div>

      <div class="visual-card main-visual-card">
        <div class="visual-card-top">
          <span class="live-dot"></span>
          <span>{% if request.LANGUAGE_CODE == 'ky' %}Коммерциялык суроо-талап{% else %}Коммерческий запрос{% endif %}</span>
          <span class="visual-status">
            ● {% if request.LANGUAGE_CODE == 'ky' %}Ачык{% else %}Открыт{% endif %}
          </span>
        </div>

        <h3>
          {% if request.LANGUAGE_CODE == 'ky' %}
            Бренддүү кутулар керек
          {% else %}
            Нужны брендированные коробки
          {% endif %}
        </h3>

        <p>
          {% if request.LANGUAGE_CODE == 'ky' %}Саны: 1 000 даана{% else %}Количество: 1 000 шт.{% endif %}
        </p>

        <div class="fake-offer">
          <span class="fake-avatar">A</span>
          <span>
            <b>Alpha Print</b>
            <small>{% if request.LANGUAGE_CODE == 'ky' %}Басмакана{% else %}Типография{% endif %}</small>
          </span>
          <strong>{% if request.LANGUAGE_CODE == 'ky' %}18 сомдон{% else %}от 18 сом{% endif %}</strong>
        </div>

        <div class="fake-offer">
          <span class="fake-avatar avatar-blue">P</span>
          <span>
            <b>Print House</b>
            <small>{% if request.LANGUAGE_CODE == 'ky' %}Таңгак өндүрүшү{% else %}Производство упаковки{% endif %}</small>
          </span>
          <strong>{% if request.LANGUAGE_CODE == 'ky' %}16 сомдон{% else %}от 16 сом{% endif %}</strong>
        </div>

        <div class="visual-bottom">
          <span>✦</span>
          {% if request.LANGUAGE_CODE == 'ky' %}Шарттарды салыштырыңыз{% else %}Сравнивайте условия{% endif %}
        </div>
      </div>

      <div class="floating-tag tag-top">
        <span class="tag-icon">↗</span>
        <span>
          <b>{% if request.LANGUAGE_CODE == 'ky' %}Бир суроо-талап{% else %}Один запрос{% endif %}</b>
          <small>{% if request.LANGUAGE_CODE == 'ky' %}Бир нече сунуш{% else %}Несколько предложений{% endif %}</small>
        </span>
      </div>

      <div class="floating-tag tag-bottom">
        <span class="tag-check">✓</span>
        <span>
          <b>{% if request.LANGUAGE_CODE == 'ky' %}Түз байланыш{% else %}Прямой контакт{% endif %}</b>
          <small>{% if request.LANGUAGE_CODE == 'ky' %}Ортомчусуз сүйлөшүңүз{% else %}Общайтесь напрямую{% endif %}</small>
        </span>
      </div>
    </div>
  </div>
</section>

<section class="trust-strip">
  <div class="container trust-grid">
    <div>
      <strong>{{ open_count }}</strong>
      <span>{% if request.LANGUAGE_CODE == 'ky' %}Ачык суроо-талаптар{% else %}Открытых запросов{% endif %}</span>
    </div>
    <div>
      <strong>01</strong>
      <span>{% if request.LANGUAGE_CODE == 'ky' %}Бир суроо-талап — бир нече сунуш{% else %}Один запрос — несколько предложений{% endif %}</span>
    </div>
    <div>
      <strong>KG</strong>
      <span>{% if request.LANGUAGE_CODE == 'ky' %}Кыргызстандагы бизнес{% else %}Бизнес Кыргызстана{% endif %}</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="eyebrow">
          {% if request.LANGUAGE_CODE == 'ky' %}Багыттар{% else %}Направления{% endif %}
        </div>
        <h2>
          {% if request.LANGUAGE_CODE == 'ky' %}
            Сиздин бизнеске эмне керек?
          {% else %}
            Что нужно вашему бизнесу?
          {% endif %}
        </h2>
      </div>
      <a class="text-link" href="{% url 'request_list' %}">
        {% if request.LANGUAGE_CODE == 'ky' %}Бардык суроо-талаптар{% else %}Все запросы{% endif %} →
      </a>
    </div>

    <div class="category-grid">
      {% for category in categories %}
        <a class="category-card" href="{% url 'request_list' %}?category={{ category.id }}">
          <span class="category-icon">
            {% if 'полиграф' in category.name_ru|lower or 'упаков' in category.name_ru|lower %}
              ▤
            {% elif 'реклам' in category.name_ru|lower %}
              ✳
            {% else %}
              ⌘
            {% endif %}
          </span>
          <h3>
            {% if request.LANGUAGE_CODE == 'ky' %}
              {{ category.name_ky }}
            {% else %}
              {{ category.name_ru }}
            {% endif %}
          </h3>
          <p>
            {{ category.request_count }}
            {% if request.LANGUAGE_CODE == 'ky' %}ачык суроо-талап{% else %}открытых запросов{% endif %}
          </p>
          <span class="card-arrow">↗</span>
        </a>
      {% empty %}
        <div class="empty-state">
          {% if request.LANGUAGE_CODE == 'ky' %}
            Категориялар жакында пайда болот. Аларды администратор /admin/ бөлүмүнөн кошо алат.
          {% else %}
            Категории скоро появятся. Администратор может добавить их в разделе /admin/.
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-muted">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="eyebrow">
          {% if request.LANGUAGE_CODE == 'ky' %}Жаңы суроо-талаптар{% else %}Свежие запросы{% endif %}
        </div>
        <h2>
          {% if request.LANGUAGE_CODE == 'ky' %}
            Компанияларга эмне керек?
          {% else %}
            Что ищут компании
          {% endif %}
        </h2>
      </div>
      <a class="text-link" href="{% url 'request_list' %}">
        {% if request.LANGUAGE_CODE == 'ky' %}Каталогго өтүү{% else %}Перейти в каталог{% endif %} →
      </a>
    </div>

    
<div class="request-grid procurement-grid">
  {% for item in recent_requests %}
    <article class="request-card procurement-card">
      <div class="request-meta">
        <span class="pill">{{ item.category }}</span>
        <span>Опубликовано {{ item.created_at|date:'d.m.Y H:i' }}</span>
      </div>

      <h3><a href="{{ item.get_absolute_url }}">{{ item.title }}</a></h3>

      <div class="procurement-organization">
        <span class="procurement-label">Заказчик</span>
        <strong>{{ item.buyer.company_name|default:item.buyer.get_full_name|default:item.buyer.username }}</strong>
      </div>

      <div class="procurement-budget">
        <span class="procurement-label">Планируемый бюджет</span>
        <strong>
          {% if item.budget_min != None or item.budget_max != None %}
            {% if item.budget_min != None and item.budget_max != None %}
              {{ item.budget_min|floatformat:"-2" }} – {{ item.budget_max|floatformat:"-2" }} сом
            {% elif item.budget_min != None %}
              От {{ item.budget_min|floatformat:"-2" }} сом
            {% else %}
              До {{ item.budget_max|floatformat:"-2" }} сом
            {% endif %}
          {% else %}
            Цена по предложению поставщика
          {% endif %}
        </strong>
      </div>

      <p class="procurement-description">{{ item.description|truncatechars:160 }}</p>

      {% if item.quantity %}
        <div class="procurement-quantity">
          <span class="procurement-label">Количество / объём</span>
          <span>{{ item.quantity }}</span>
        </div>
      {% endif %}

      <div class="procurement-dates">
        <div>
          <span class="procurement-label">Дата публикации</span>
          <strong>{{ item.created_at|date:'d.m.Y' }}</strong>
        </div>
        <div>
          <span class="procurement-label">Срок подачи предложений</span>
          <strong>{% if item.deadline %}{{ item.deadline|date:'d.m.Y' }}{% else %}Не указан{% endif %}</strong>
        </div>
      </div>

      <div class="procurement-bottom">
        <span>⌖ {{ item.city|default:'Кыргызстан' }}</span>
        <span>Предложений: {{ item.offers.count }}</span>
      </div>

      <a class="btn btn-primary btn-block procurement-action" href="{{ item.get_absolute_url }}">Посмотреть заявку и условия →</a>
    </article>
  {% empty %}
    <div class="empty-state">
      Пока нет опубликованных запросов.
      <a href="{% url 'request_create' %}">Создайте первый запрос</a>.
    </div>
  {% endfor %}
</div>

  </div>
</section>


<section class="section" id="home-supplier-listings">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Каталог поставщиков</div>
        <h2>Товары и услуги для вашего бизнеса</h2>
      </div>
      <a class="text-link" href="{% url 'supplier_listing_list' %}">
        Все предложения →
      </a>
    </div>

    <div class="request-grid">
      {% for item in supplier_listings %}
        <article class="request-card">
          {% if item.image_url %}
            <img src="{{ item.image_url }}"
                 alt="{{ item.title }}"
                 loading="lazy"
                 style="width:100%;max-height:220px;object-fit:cover;border-radius:12px">
          {% endif %}

          <div class="request-meta">
            <span class="pill">{{ item.category }}</span>
            <span>{{ item.created_at|date:"d.m.Y" }}</span>
          </div>

          <h3><a href="{{ item.get_absolute_url }}">{{ item.title }}</a></h3>
          <p>{{ item.description|truncatechars:160 }}</p>

          <p>
            <strong>Поставщик:</strong>
            {{ item.supplier.company_name|default:item.supplier.get_full_name|default:item.supplier.username }}
          </p>

          <p>
            <strong>Цена:</strong>
            {% if item.price != None %}
              {{ item.price|floatformat:"-2" }} сом
            {% else %}
              По договорённости
            {% endif %}
          </p>

          {% if item.quantity %}
            <p><strong>Количество:</strong> {{ item.quantity }}</p>
          {% endif %}

          <p><strong>Город:</strong> {{ item.city|default:"Не указан" }}</p>

          <a class="btn btn-primary btn-block"
             href="{{ item.get_absolute_url }}">Подробнее →</a>
        </article>
      {% empty %}
        <div class="empty-state">
          Пока нет опубликованных предложений поставщиков.
          <a href="{% url 'supplier_listing_list' %}">Посмотреть все предложения</a>
        </div>
      {% endfor %}
    </div>

    {% if user.is_authenticated %}
      {% if user.role == "supplier" or user.role == "both" or user.is_staff %}
        <p>
          <a class="btn btn-secondary" href="{% url 'supplier_listing_create' %}">
            Разместить своё предложение
          </a>
        </p>
      {% endif %}
    {% else %}
      <p>
        <a class="btn btn-secondary"
           href="{% url 'login' %}?next={% url 'supplier_listing_create' %}">
          Войдите, чтобы разместить предложение
        </a>
      </p>
    {% endif %}
  </div>
</section>

<section class="cta-section">
  <div class="container cta-box">
    <div>
      <div class="eyebrow eyebrow-light">BaaTap KG</div>
      <h2>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Кийинки бизнес өнөктөшүңүздү табыңыз
        {% else %}
          Найдите следующего бизнес-партнёра
        {% endif %}
      </h2>
      <p>
        {% if request.LANGUAGE_CODE == 'ky' %}
          Бүгүн катталып, биринчи суроо-талабыңызды жарыялаңыз.
        {% else %}
          Зарегистрируйтесь и опубликуйте первый коммерческий запрос.
        {% endif %}
      </p>
    </div>
    <a class="btn btn-white" href="{% url 'register' %}">
      {% if request.LANGUAGE_CODE == 'ky' %}Баштоо{% else %}Начать бесплатно{% endif %} →
    </a>
  </div>
</section>

{% endblock %}
