{% extends 'base.html' %}{% block title %}BaaTap KG вЂ” находите поставщиков{% endblock %}{% block content %}
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-dot"></span>{% if request.LANGUAGE_CODE == 'ky' %}РљС‹СЂРіС‹Р·СЃС‚Р°РЅРґР°РіС‹ Р¶РµРєРµ бизнес үчүн{% else %}Р”Р»СЏ С‡Р°СЃС‚РЅРѕРіРѕ бизнеса РљС‹СЂРіС‹Р·СЃС‚Р°РЅР°{% endif %}</div><h1>{% if request.LANGUAGE_CODE == 'ky' %}Керектүү жеткирүүчүнү <span>РѕТЈРѕР№ С‚Р°Р±С‹ТЈС‹Р·.</span>{% else %}Находите РЅСѓР¶РЅС‹С… поставщиков <span>Р±РµР· лишних поисков.</span>{% endif %}</h1><p>{% if request.LANGUAGE_CODE == 'ky' %}Бир коммерциялык СЃСѓСЂРѕРѕ түзүңүз. РЎСѓРЅСѓС€С‚Р°СЂРґС‹ Р°Р»С‹Рї, Р±Р°Р°РЅС‹ Р¶Р°РЅР° С€Р°СЂС‚С‚Р°СЂРґС‹ СЃР°Р»С‹С€С‚С‹СЂС‹ТЈС‹Р·.{% else %}Опубликуйте коммерческий Р·Р°РїСЂРѕСЃ, получите предложения и сравните С†РµРЅС‹ и условия РѕС‚ поставщиков.{% endif %}</p><div class="hero-actions"><a class="btn btn-primary" href="{% url 'request_create' %}">{% if request.LANGUAGE_CODE == 'ky' %}РЎСѓСЂРѕРѕ түзүү{% else %}РЎРѕР·РґР°С‚СЊ Р·Р°РїСЂРѕСЃ{% endif %}<span>→</span></a><a class="btn btn-secondary" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}РЎСѓСЂРѕРѕР»РѕСЂРґСѓ көрүү{% else %}РЎРјРѕС‚СЂРµС‚СЊ Р·Р°РїСЂРѕСЃС‹{% endif %}</a></div><div class="hero-note"><span class="checkmark">✓</span>{% if request.LANGUAGE_CODE == 'ky' %}РљР°С‚С‚Р°Р»СѓСѓ Р°РєС‹СЃС‹Р· В· Сүйлөшүүлөр түз жүргүзүлөт{% else %}Р‘РµСЃРїР»Р°С‚РЅР°СЏ регистрация В· Общение РЅР°РїСЂСЏРјСѓСЋ{% endif %}</div></div><div class="hero-visual"><div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div><div class="visual-card main-visual-card"><div class="visual-card-top"><span class="live-dot"></span><span>{% if request.LANGUAGE_CODE == 'ky' %}Коммерциялык СЃСѓСЂРѕРѕ{% else %}Коммерческий Р·Р°РїСЂРѕСЃ{% endif %}</span><span class="visual-status">в—Џ {% if request.LANGUAGE_CODE == 'ky' %}РђС‡С‹Рє{% else %}РћС‚РєСЂС‹С‚{% endif %}</span></div><h3>{% if request.LANGUAGE_CODE == 'ky' %}Бренддүү РєСѓС‚СѓР»Р°СЂ РєРµСЂРµРє{% else %}РќСѓР¶РЅС‹ брендированные коробки{% endif %}</h3><p>{% if request.LANGUAGE_CODE == 'ky' %}Көлөмү: 1 000 РґР°Р°РЅР°{% else %}Количество: 1 000 С€С‚.{% endif %}</p><div class="fake-offer"><span class="fake-avatar">A</span><span><b>Alpha Print</b><small>{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°СЃРјР°РєР°РЅР°{% else %}Типография{% endif %}</small></span><strong>РѕС‚ 18 СЃРѕРј</strong></div><div class="fake-offer"><span class="fake-avatar avatar-blue">P</span><span><b>Print House</b><small>{% if request.LANGUAGE_CODE == 'ky' %}РўР°ТЈРіР°Рє өндүрүшү{% else %}Производство упаковки{% endif %}</small></span><strong>РѕС‚ 16 СЃРѕРј</strong></div><div class="visual-bottom"><span>✦</span>{% if request.LANGUAGE_CODE == 'ky' %}Шарттарды СЃР°Р»С‹С€С‚С‹СЂС‹ТЈС‹Р·{% else %}Сравнивайте условия{% endif %}</div></div><div class="floating-tag tag-top"><span class="tag-icon">↗</span><span><b>{% if request.LANGUAGE_CODE == 'ky' %}Бир СЃСѓСЂРѕРѕ{% else %}Один Р·Р°РїСЂРѕСЃ{% endif %}</b><small>{% if request.LANGUAGE_CODE == 'ky' %}Бир РЅРµС‡Рµ СЃСѓРЅСѓС€{% else %}РќРµСЃРєРѕР»СЊРєРѕ предложений{% endif %}</small></span></div><div class="floating-tag tag-bottom"><span class="tag-check">✓</span><span><b>{% if request.LANGUAGE_CODE == 'ky' %}Түз Р±Р°Р№Р»Р°РЅС‹С€{% else %}РџСЂСЏРјРѕР№ РєРѕРЅС‚Р°РєС‚{% endif %}</b><small>{% if request.LANGUAGE_CODE == 'ky' %}РћСЂС‚РѕРјС‡СѓСЃСѓР· сүйлөшүңүз{% else %}РћР±С‰Р°Р№С‚РµСЃСЊ РЅР°РїСЂСЏРјСѓСЋ{% endif %}</small></span></div></div></div></section>
<section class="trust-strip"><div class="container trust-grid"><div><strong>{{ open_count }}</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}Р°С‡С‹Рє СЃСѓСЂРѕРѕ{% else %}РѕС‚РєСЂС‹С‚С‹С… Р·Р°РїСЂРѕСЃРѕРІ{% endif %}</span></div><div><strong>01</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}СЃСѓСЂРѕРѕ вЂ” бир РЅРµС‡Рµ СЃСѓРЅСѓС€{% else %}Р·Р°РїСЂРѕСЃ вЂ” РЅРµСЃРєРѕР»СЊРєРѕ предложений{% endif %}</span></div><div><strong>KG</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}РљС‹СЂРіС‹Р·СЃС‚Р°РЅРґР°РіС‹ бизнес{% else %}бизнес РљС‹СЂРіС‹Р·СЃС‚Р°РЅР°{% endif %}</span></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°РіС‹С‚С‚Р°СЂ{% else %}Направления{% endif %}</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}РљР°Р№СЃС‹ РєС‹Р·РјР°С‚ РєРµСЂРµРє?{% else %}Р§С‚Рѕ РЅСѓР¶РЅРѕ РІР°С€РµРјСѓ бизнесу?{% endif %}</h2></div><a class="text-link" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°СЂРґС‹Рє СЃСѓСЂРѕРѕР»РѕСЂ{% else %}Р’СЃРµ Р·Р°РїСЂРѕСЃС‹{% endif %} →</a></div><div class="category-grid">{% for category in categories %}<a class="category-card" href="{% url 'request_list' %}?category={{ category.id }}"><span class="category-icon">{% if 'РїРѕР»РёРіСЂР°С„' in category.name_ru|lower or 'СѓРїР°РєРѕРІ' in category.name_ru|lower %}в–¤{% elif 'СЂРµРєР»Р°Рј' in category.name_ru|lower %}✳{% else %}вЊ{% endif %}</span><h3>{% if request.LANGUAGE_CODE == 'ky' %}{{ category.name_ky }}{% else %}{{ category.name_ru }}{% endif %}</h3><p>{{ category.request_count }} {% if request.LANGUAGE_CODE == 'ky' %}Р°С‡С‹Рє СЃСѓСЂРѕРѕ{% else %}РѕС‚РєСЂС‹С‚С‹С… Р·Р°РїСЂРѕСЃРѕРІ{% endif %}</p><span class="card-arrow">↗</span></a>{% empty %}<div class="empty-state">Категории СЃРєРѕСЂРѕ РїРѕСЏРІСЏС‚СЃСЏ. Администратор РјРѕР¶РµС‚ добавить их РІ /admin/.</div>{% endfor %}</div></div></section>
<section class="section section-muted"><div class="container"><div class="section-heading"><div><div class="eyebrow">{% if request.LANGUAGE_CODE == 'ky' %}Р–Р°ТЈС‹ СЃСѓСЂРѕРѕР»РѕСЂ{% else %}Свежие Р·Р°РїСЂРѕСЃС‹{% endif %}</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}Бизнеске СЌРјРЅРµ РєРµСЂРµРє?{% else %}Р§С‚Рѕ ищут компании{% endif %}</h2></div><a class="text-link" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}РљР°С‚Р°Р»РѕРіРіРѕ өтүү{% else %}Перейти РІ РєР°С‚Р°Р»РѕРі{% endif %} →</a></div><div class="request-grid">{% for item in recent_requests %}<article class="request-card"><div class="request-meta"><span class="pill">{{ item.category.name_ru }}</span><span>{{ item.created_at|date:'d.m.Y' }}</span></div><h3><a href="{{ item.get_absolute_url }}">{{ item.title }}</a></h3><p>{{ item.description|truncatechars:130 }}</p><div class="request-card-bottom"><span>вЊ– {{ item.city|default:'РљС‹СЂРіС‹Р·СЃС‚Р°РЅ' }}</span><span>{{ item.offers.count }} {% if request.LANGUAGE_CODE == 'ky' %}СЃСѓРЅСѓС€{% else %}предложений{% endif %}</span></div></article>{% empty %}<div class="empty-state">РџРѕРєР° РЅРµС‚ опубликованных Р·Р°РїСЂРѕСЃРѕРІ. РЎС‚Р°РЅСЊС‚Рµ РїРµСЂРІС‹Рј вЂ” <a href="{% url 'request_create' %}">СЃРѕР·РґР°Р№С‚Рµ Р·Р°РїСЂРѕСЃ</a>.</div>{% endfor %}</div></div></section>
<section class="cta-section"><div class="container cta-box"><div><div class="eyebrow eyebrow-light">BaaTap KG</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}Кийинки бизнес өнөктөшүңүздү С‚Р°Р±С‹ТЈС‹Р·{% else %}Найдите СЃР»РµРґСѓСЋС‰РµРіРѕ бизнес-партнёра{% endif %}</h2><p>{% if request.LANGUAGE_CODE == 'ky' %}Бүгүн РєР°С‚С‚Р°Р»С‹Рї, биринчи СЃСѓСЂРѕРѕТЈСѓР·РґСѓ Р¶Р°СЂС‹СЏР»Р°ТЈС‹Р·.{% else %}Зарегистрируйтесь и опубликуйте РїРµСЂРІС‹Р№ коммерческий Р·Р°РїСЂРѕСЃ.{% endif %}</p></div><a class="btn btn-white" href="{% url 'register' %}">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°С€С‚РѕРѕ{% else %}РќР°С‡Р°С‚СЊ Р±РµСЃРїР»Р°С‚РЅРѕ{% endif %} →</a></div></section>
{% endblock %}

