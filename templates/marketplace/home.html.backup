{% extends 'base.html' %}{% block title %}BaaTap KG вЂ” РЅР°С…РѕРґРёС‚Рµ РїРѕСЃС‚Р°РІС‰РёРєРѕРІ{% endblock %}{% block content %}
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-dot"></span>{% if request.LANGUAGE_CODE == 'ky' %}РљС‹СЂРіС‹Р·СЃС‚Р°РЅРґР°РіС‹ Р¶РµРєРµ Р±РёР·РЅРµСЃ ТЇС‡ТЇРЅ{% else %}Р”Р»СЏ С‡Р°СЃС‚РЅРѕРіРѕ Р±РёР·РЅРµСЃР° РљС‹СЂРіС‹Р·СЃС‚Р°РЅР°{% endif %}</div><h1>{% if request.LANGUAGE_CODE == 'ky' %}РљРµСЂРµРєС‚ТЇТЇ Р¶РµС‚РєРёСЂТЇТЇС‡ТЇРЅТЇ <span>РѕТЈРѕР№ С‚Р°Р±С‹ТЈС‹Р·.</span>{% else %}РќР°С…РѕРґРёС‚Рµ РЅСѓР¶РЅС‹С… РїРѕСЃС‚Р°РІС‰РёРєРѕРІ <span>Р±РµР· Р»РёС€РЅРёС… РїРѕРёСЃРєРѕРІ.</span>{% endif %}</h1><p>{% if request.LANGUAGE_CODE == 'ky' %}Р‘РёСЂ РєРѕРјРјРµСЂС†РёСЏР»С‹Рє СЃСѓСЂРѕРѕ С‚ТЇР·ТЇТЈТЇР·. РЎСѓРЅСѓС€С‚Р°СЂРґС‹ Р°Р»С‹Рї, Р±Р°Р°РЅС‹ Р¶Р°РЅР° С€Р°СЂС‚С‚Р°СЂРґС‹ СЃР°Р»С‹С€С‚С‹СЂС‹ТЈС‹Р·.{% else %}РћРїСѓР±Р»РёРєСѓР№С‚Рµ РєРѕРјРјРµСЂС‡РµСЃРєРёР№ Р·Р°РїСЂРѕСЃ, РїРѕР»СѓС‡РёС‚Рµ РїСЂРµРґР»РѕР¶РµРЅРёСЏ Рё СЃСЂР°РІРЅРёС‚Рµ С†РµРЅС‹ Рё СѓСЃР»РѕРІРёСЏ РѕС‚ РїРѕСЃС‚Р°РІС‰РёРєРѕРІ.{% endif %}</p><div class="hero-actions"><a class="btn btn-primary" href="{% url 'request_create' %}">{% if request.LANGUAGE_CODE == 'ky' %}РЎСѓСЂРѕРѕ С‚ТЇР·ТЇТЇ{% else %}РЎРѕР·РґР°С‚СЊ Р·Р°РїСЂРѕСЃ{% endif %}<span>в†’</span></a><a class="btn btn-secondary" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}РЎСѓСЂРѕРѕР»РѕСЂРґСѓ РєУ©СЂТЇТЇ{% else %}РЎРјРѕС‚СЂРµС‚СЊ Р·Р°РїСЂРѕСЃС‹{% endif %}</a></div><div class="hero-note"><span class="checkmark">вњ“</span>{% if request.LANGUAGE_CODE == 'ky' %}РљР°С‚С‚Р°Р»СѓСѓ Р°РєС‹СЃС‹Р· В· РЎТЇР№Р»У©С€ТЇТЇР»У©СЂ С‚ТЇР· Р¶ТЇСЂРіТЇР·ТЇР»У©С‚{% else %}Р‘РµСЃРїР»Р°С‚РЅР°СЏ СЂРµРіРёСЃС‚СЂР°С†РёСЏ В· РћР±С‰РµРЅРёРµ РЅР°РїСЂСЏРјСѓСЋ{% endif %}</div></div><div class="hero-visual"><div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div><div class="visual-card main-visual-card"><div class="visual-card-top"><span class="live-dot"></span><span>{% if request.LANGUAGE_CODE == 'ky' %}РљРѕРјРјРµСЂС†РёСЏР»С‹Рє СЃСѓСЂРѕРѕ{% else %}РљРѕРјРјРµСЂС‡РµСЃРєРёР№ Р·Р°РїСЂРѕСЃ{% endif %}</span><span class="visual-status">в—Џ {% if request.LANGUAGE_CODE == 'ky' %}РђС‡С‹Рє{% else %}РћС‚РєСЂС‹С‚{% endif %}</span></div><h3>{% if request.LANGUAGE_CODE == 'ky' %}Р‘СЂРµРЅРґРґТЇТЇ РєСѓС‚СѓР»Р°СЂ РєРµСЂРµРє{% else %}РќСѓР¶РЅС‹ Р±СЂРµРЅРґРёСЂРѕРІР°РЅРЅС‹Рµ РєРѕСЂРѕР±РєРё{% endif %}</h3><p>{% if request.LANGUAGE_CODE == 'ky' %}РљУ©Р»У©РјТЇ: 1 000 РґР°Р°РЅР°{% else %}РљРѕР»РёС‡РµСЃС‚РІРѕ: 1 000 С€С‚.{% endif %}</p><div class="fake-offer"><span class="fake-avatar">A</span><span><b>Alpha Print</b><small>{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°СЃРјР°РєР°РЅР°{% else %}РўРёРїРѕРіСЂР°С„РёСЏ{% endif %}</small></span><strong>РѕС‚ 18 СЃРѕРј</strong></div><div class="fake-offer"><span class="fake-avatar avatar-blue">P</span><span><b>Print House</b><small>{% if request.LANGUAGE_CODE == 'ky' %}РўР°ТЈРіР°Рє У©РЅРґТЇСЂТЇС€ТЇ{% else %}РџСЂРѕРёР·РІРѕРґСЃС‚РІРѕ СѓРїР°РєРѕРІРєРё{% endif %}</small></span><strong>РѕС‚ 16 СЃРѕРј</strong></div><div class="visual-bottom"><span>вњ¦</span>{% if request.LANGUAGE_CODE == 'ky' %}РЁР°СЂС‚С‚Р°СЂРґС‹ СЃР°Р»С‹С€С‚С‹СЂС‹ТЈС‹Р·{% else %}РЎСЂР°РІРЅРёРІР°Р№С‚Рµ СѓСЃР»РѕРІРёСЏ{% endif %}</div></div><div class="floating-tag tag-top"><span class="tag-icon">в†—</span><span><b>{% if request.LANGUAGE_CODE == 'ky' %}Р‘РёСЂ СЃСѓСЂРѕРѕ{% else %}РћРґРёРЅ Р·Р°РїСЂРѕСЃ{% endif %}</b><small>{% if request.LANGUAGE_CODE == 'ky' %}Р‘РёСЂ РЅРµС‡Рµ СЃСѓРЅСѓС€{% else %}РќРµСЃРєРѕР»СЊРєРѕ РїСЂРµРґР»РѕР¶РµРЅРёР№{% endif %}</small></span></div><div class="floating-tag tag-bottom"><span class="tag-check">вњ“</span><span><b>{% if request.LANGUAGE_CODE == 'ky' %}РўТЇР· Р±Р°Р№Р»Р°РЅС‹С€{% else %}РџСЂСЏРјРѕР№ РєРѕРЅС‚Р°РєС‚{% endif %}</b><small>{% if request.LANGUAGE_CODE == 'ky' %}РћСЂС‚РѕРјС‡СѓСЃСѓР· СЃТЇР№Р»У©С€ТЇТЈТЇР·{% else %}РћР±С‰Р°Р№С‚РµСЃСЊ РЅР°РїСЂСЏРјСѓСЋ{% endif %}</small></span></div></div></div></section>
<section class="trust-strip"><div class="container trust-grid"><div><strong>{{ open_count }}</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}Р°С‡С‹Рє СЃСѓСЂРѕРѕ{% else %}РѕС‚РєСЂС‹С‚С‹С… Р·Р°РїСЂРѕСЃРѕРІ{% endif %}</span></div><div><strong>01</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}СЃСѓСЂРѕРѕ вЂ” Р±РёСЂ РЅРµС‡Рµ СЃСѓРЅСѓС€{% else %}Р·Р°РїСЂРѕСЃ вЂ” РЅРµСЃРєРѕР»СЊРєРѕ РїСЂРµРґР»РѕР¶РµРЅРёР№{% endif %}</span></div><div><strong>KG</strong><span>{% if request.LANGUAGE_CODE == 'ky' %}РљС‹СЂРіС‹Р·СЃС‚Р°РЅРґР°РіС‹ Р±РёР·РЅРµСЃ{% else %}Р±РёР·РЅРµСЃ РљС‹СЂРіС‹Р·СЃС‚Р°РЅР°{% endif %}</span></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°РіС‹С‚С‚Р°СЂ{% else %}РќР°РїСЂР°РІР»РµРЅРёСЏ{% endif %}</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}РљР°Р№СЃС‹ РєС‹Р·РјР°С‚ РєРµСЂРµРє?{% else %}Р§С‚Рѕ РЅСѓР¶РЅРѕ РІР°С€РµРјСѓ Р±РёР·РЅРµСЃСѓ?{% endif %}</h2></div><a class="text-link" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°СЂРґС‹Рє СЃСѓСЂРѕРѕР»РѕСЂ{% else %}Р’СЃРµ Р·Р°РїСЂРѕСЃС‹{% endif %} в†’</a></div><div class="category-grid">{% for category in categories %}<a class="category-card" href="{% url 'request_list' %}?category={{ category.id }}"><span class="category-icon">{% if 'РїРѕР»РёРіСЂР°С„' in category.name_ru|lower or 'СѓРїР°РєРѕРІ' in category.name_ru|lower %}в–¤{% elif 'СЂРµРєР»Р°Рј' in category.name_ru|lower %}вњі{% else %}вЊ{% endif %}</span><h3>{% if request.LANGUAGE_CODE == 'ky' %}{{ category.name_ky }}{% else %}{{ category.name_ru }}{% endif %}</h3><p>{{ category.request_count }} {% if request.LANGUAGE_CODE == 'ky' %}Р°С‡С‹Рє СЃСѓСЂРѕРѕ{% else %}РѕС‚РєСЂС‹С‚С‹С… Р·Р°РїСЂРѕСЃРѕРІ{% endif %}</p><span class="card-arrow">в†—</span></a>{% empty %}<div class="empty-state">РљР°С‚РµРіРѕСЂРёРё СЃРєРѕСЂРѕ РїРѕСЏРІСЏС‚СЃСЏ. РђРґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂ РјРѕР¶РµС‚ РґРѕР±Р°РІРёС‚СЊ РёС… РІ /admin/.</div>{% endfor %}</div></div></section>
<section class="section section-muted"><div class="container"><div class="section-heading"><div><div class="eyebrow">{% if request.LANGUAGE_CODE == 'ky' %}Р–Р°ТЈС‹ СЃСѓСЂРѕРѕР»РѕСЂ{% else %}РЎРІРµР¶РёРµ Р·Р°РїСЂРѕСЃС‹{% endif %}</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}Р‘РёР·РЅРµСЃРєРµ СЌРјРЅРµ РєРµСЂРµРє?{% else %}Р§С‚Рѕ РёС‰СѓС‚ РєРѕРјРїР°РЅРёРё{% endif %}</h2></div><a class="text-link" href="{% url 'request_list' %}">{% if request.LANGUAGE_CODE == 'ky' %}РљР°С‚Р°Р»РѕРіРіРѕ У©С‚ТЇТЇ{% else %}РџРµСЂРµР№С‚Рё РІ РєР°С‚Р°Р»РѕРі{% endif %} в†’</a></div><div class="request-grid">{% for item in recent_requests %}<article class="request-card"><div class="request-meta"><span class="pill">{{ item.category.name_ru }}</span><span>{{ item.created_at|date:'d.m.Y' }}</span></div><h3><a href="{{ item.get_absolute_url }}">{{ item.title }}</a></h3><p>{{ item.description|truncatechars:130 }}</p><div class="request-card-bottom"><span>вЊ– {{ item.city|default:'РљС‹СЂРіС‹Р·СЃС‚Р°РЅ' }}</span><span>{{ item.offers.count }} {% if request.LANGUAGE_CODE == 'ky' %}СЃСѓРЅСѓС€{% else %}РїСЂРµРґР»РѕР¶РµРЅРёР№{% endif %}</span></div></article>{% empty %}<div class="empty-state">РџРѕРєР° РЅРµС‚ РѕРїСѓР±Р»РёРєРѕРІР°РЅРЅС‹С… Р·Р°РїСЂРѕСЃРѕРІ. РЎС‚Р°РЅСЊС‚Рµ РїРµСЂРІС‹Рј вЂ” <a href="{% url 'request_create' %}">СЃРѕР·РґР°Р№С‚Рµ Р·Р°РїСЂРѕСЃ</a>.</div>{% endfor %}</div></div></section>
<section class="cta-section"><div class="container cta-box"><div><div class="eyebrow eyebrow-light">BaaTap KG</div><h2>{% if request.LANGUAGE_CODE == 'ky' %}РљРёР№РёРЅРєРё Р±РёР·РЅРµСЃ У©РЅУ©РєС‚У©С€ТЇТЈТЇР·РґТЇ С‚Р°Р±С‹ТЈС‹Р·{% else %}РќР°Р№РґРёС‚Рµ СЃР»РµРґСѓСЋС‰РµРіРѕ Р±РёР·РЅРµСЃ-РїР°СЂС‚РЅС‘СЂР°{% endif %}</h2><p>{% if request.LANGUAGE_CODE == 'ky' %}Р‘ТЇРіТЇРЅ РєР°С‚С‚Р°Р»С‹Рї, Р±РёСЂРёРЅС‡Рё СЃСѓСЂРѕРѕТЈСѓР·РґСѓ Р¶Р°СЂС‹СЏР»Р°ТЈС‹Р·.{% else %}Р—Р°СЂРµРіРёСЃС‚СЂРёСЂСѓР№С‚РµСЃСЊ Рё РѕРїСѓР±Р»РёРєСѓР№С‚Рµ РїРµСЂРІС‹Р№ РєРѕРјРјРµСЂС‡РµСЃРєРёР№ Р·Р°РїСЂРѕСЃ.{% endif %}</p></div><a class="btn btn-white" href="{% url 'register' %}">{% if request.LANGUAGE_CODE == 'ky' %}Р‘Р°С€С‚РѕРѕ{% else %}РќР°С‡Р°С‚СЊ Р±РµСЃРїР»Р°С‚РЅРѕ{% endif %} в†’</a></div></section>
{% endblock %}

