{% extends 'base.html' %}{% block title %}{{ item.title }} — BaaTap KG{% endblock %}{% block content %}<section class="section"><div class="container detail-layout"><div class="detail-main"><a class="back-link" href="{% url 'request_list' %}">← Все запросы</a><div class="detail-card"><div class="request-meta"><span class="pill">{{ item.category.name_ru }}</span><span class="status-pill">{% if item.status == 'open' %}Открыт{% elif item.status == 'paused' %}Приостановлен{% else %}Закрыт{% endif %}</span></div><h1>{{ item.title }}</h1><p class="detail-description">{{ item.description|linebreaksbr }}</p><div class="detail-facts"><div><small>Количество</small><b>{{ item.quantity|default:'Не указано' }}</b></div><div><small>Бюджет</small><b>{% if item.budget_min or item.budget_max %}{{ item.budget_min|default:'—' }} – {{ item.budget_max|default:'—' }} сом{% else %}По предложению{% endif %}</b></div><div><small>Город</small><b>{{ item.city|default:'Кыргызстан' }}</b></div><div><small>Желаемый срок</small><b>{{ item.deadline|date:'d.m.Y'|default:'Не указан' }}</b></div></div><div class="request-author"><span class="fake-avatar">{{ item.buyer.company_name|default:item.buyer.username|slice:':1'|upper }}</span><span><b>{{ item.buyer.company_name|default:item.buyer.get_full_name|default:item.buyer.username }}</b><small>Опубликовано {{ item.created_at|date:'d.m.Y H:i' }}</small></span></div>{% if user == item.buyer %}<a class="btn btn-secondary" href="{% url 'request_edit' item.pk %}">Редактировать запрос</a>{% endif %}</div>{% if can_view_offers %}<div class="offers-section"><h2>Предложения поставщиков ({{ offer_count }})</h2>{% for offer in offers %}<div class="offer-card"><div class="offer-head"><div><b>{{ offer.supplier.company_name|default:offer.supplier.username }}</b><small>{{ offer.supplier.city }}</small></div><strong>{{ offer.price|floatformat:2 }} сом</strong></div><p>{{ offer.details|default:'Без дополнительного комментария.' }}</p><div class="request-card-bottom"><span>Срок: {{ offer.delivery_days }} дн.</span><a href="{% url 'supplier_detail' offer.supplier.username %}">Профиль поставщика →</a></div></div>{% empty %}<p class="muted">Пока никто не отправил предложение.</p>{% endfor %}</div>{% endif %}</div><aside class="detail-sidebar"><div class="sidebar-card"><h3>{% if user == item.buyer %}Ваша заявка{% else %}Есть подходящее предложение?{% endif %}</h3><p>{% if user == item.buyer %}Поделитесь ссылкой на запрос с поставщиками, чтобы получить больше ответов.{% else %}Отправьте цену и срок выполнения. Покупатель увидит ваше предложение в личном кабинете.{% endif %}</p>{% if user.is_authenticated and user != item.buyer and item.status == 'open' %}<a class="btn btn-primary btn-block" href="{% url 'offer_create' item.pk %}">{% if my_offer %}Изменить предложение{% else %}Отправить предложение{% endif %} →</a>{% elif not user.is_authenticated %}<a class="btn btn-primary btn-block" href="{% url 'login' %}?next={{ request.path }}">Войдите, чтобы ответить</a><a class="text-link centered" href="{% url 'register' %}">Создать аккаунт</a>{% endif %}<div class="sidebar-divider"></div><div class="privacy-note">ⓘ Контакты и условия стороны согласуют напрямую. BaaTap KG не проводит государственные закупки.</div></div></aside></div></section>{% endblock %}
