{% extends 'base.html' %}{% block title %}Мой кабинет — BaaTap KG{% endblock %}{% block content %}<section class="page-hero"><div class="container"><div class="eyebrow">BaaTap KG / Кабинет</div><h1>Здравствуйте, {{ user.first_name|default:user.username }}!</h1><p>Управляйте коммерческими запросами и предложениями в одном месте.</p><div class="hero-actions"><a class="btn btn-primary" href="{% url 'request_create' %}">+ Создать запрос</a><a class="btn btn-secondary" href="{% url 'profile_edit' %}">Настроить профиль</a></div></div></section><section class="section"><div class="container dashboard-grid"><div class="dashboard-panel"><div class="panel-heading"><h2>Мои запросы</h2><span class="count-badge">{{ my_requests|length }}</span></div>{% for item in my_requests %}<a class="dashboard-row" href="{{ item.get_absolute_url }}"><span><b>{{ item.title }}</b><small>{{ item.category.name_ru }} · {{ item.created_at|date:'d.m.Y' }}</small></span><span class="row-end"><small>{{ item.offers.count }} предл.</small> →</span></a>{% empty %}<div class="empty-inline">Вы ещё не создавали запросы. <a href="{% url 'request_create' %}">Создать первый</a></div>{% endfor %}</div><div class="dashboard-panel"><div class="panel-heading"><h2>Мои предложения</h2><span class="count-badge">{{ my_offers|length }}</span></div>{% for offer in my_offers %}<a class="dashboard-row" href="{{ offer.request.get_absolute_url }}"><span><b>{{ offer.request.title }}</b><small>{{ offer.price|floatformat:2 }} сом · {{ offer.created_at|date:'d.m.Y' }}</small></span><span class="row-end">→</span></a>{% empty %}<div class="empty-inline">Вы ещё не отправляли предложений. <a href="{% url 'request_list' %}">Найти запросы</a></div>{% endfor %}</div></div></section>{% endblock %}
