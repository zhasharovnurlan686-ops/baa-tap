        <span class="count-badge">{{ my_offers|length }}</span>
      </div>
      {% for offer in my_offers %}
        <a class="dashboard-row" href="{{ offer.request.get_absolute_url }}">
          <span class="dashboard-row-main">
            <b>{{ offer.request.title }}</b>
            <small>{{ offer.price|floatformat:2 }} &#1089;&#1086;&#1084; &middot; {{ offer.created_at|date:'d.m.Y' }}</small>
          </span>
          <span class="row-end"><span aria-hidden="true">&rarr;</span></span>
        </a>
      {% empty %}
        <div class="empty-inline">
          &#1042;&#1099; &#1087;&#1086;&#1082;&#1072; &#1085;&#1077; &#1086;&#1090;&#1087;&#1088;&#1072;&#1074;&#1083;&#1103;&#1083;&#1080; &#1087;&#1088;&#1077;&#1076;&#1083;&#1086;&#1078;&#1077;&#1085;&#1080;&#1081;.
          <a href="{% url 'request_list' %}">&#1053;&#1072;&#1081;&#1090;&#1080; &#1079;&#1072;&#1087;&#1088;&#1086;&#1089;&#1099;</a>
