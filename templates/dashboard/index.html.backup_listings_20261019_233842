        <span class="count-badge">{{ my_requests|length }}</span>
      </div>
      {% for item in my_requests %}
        <a class="dashboard-row" href="{{ item.get_absolute_url }}">
          <span class="dashboard-row-main">
            <b>{{ item.title }}</b>
            <small>{{ item.category.name_ru }} &middot; {{ item.created_at|date:'d.m.Y' }}</small>
          </span>
          <span class="row-end">
            <small>{{ item.offers.count }} &#1087;&#1088;&#1077;&#1076;&#1083;.</small>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {% empty %}
        <div class="empty-inline">
          &#1042;&#1099; &#1087;&#1086;&#1082;&#1072; &#1085;&#1077; &#1089;&#1086;&#1079;&#1076;&#1072;&#1074;&#1072;&#1083;&#1080; &#1079;&#1072;&#1087;&#1088;&#1086;&#1089;&#1099;.
          {% if user.role == "buyer" or user.role == "both" or user.is_staff %}
            <a href="{% url 'request_create' %}">&#1057;&#1086;&#1079;&#1076;&#1072;&#1090;&#1100; &#1087;&#1077;&#1088;&#1074;&#1099;&#1081;</a>
          {% endif %}
