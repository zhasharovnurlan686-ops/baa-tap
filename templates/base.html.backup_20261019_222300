
{% load static %}

<!doctype html>
<html lang="{{ LANGUAGE_CODE|default:'ru' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{% block title %}BaaTap KG — поставщики и коммерческие предложения{% endblock %}</title>

<meta name="description" content="BaaTap KG помогает частным компаниям находить поставщиков и сравнивать коммерческие предложения.">

<link rel="stylesheet" href="{% static 'css/style.css' %}">
</head>

<body>

<div class="topline">
    <div class="container topline-inner">
        <span>
            {% if request.LANGUAGE_CODE == 'ky' %}
                Кыргызстандагы бизнес үчүн
            {% else %}
                Сервис для частного бизнеса Кыргызстана
            {% endif %}
        </span>

        <form action="{% url 'set_language' %}" method="post" class="lang-form">
            {% csrf_token %}
            <input name="next" type="hidden" value="{{ request.get_full_path }}">

            <button name="language" value="ru"
                    class="lang-button {% if request.LANGUAGE_CODE != 'ky' %}active{% endif %}">
                RU
            </button>

            <button name="language" value="ky"
                    class="lang-button {% if request.LANGUAGE_CODE == 'ky' %}active{% endif %}">
                KG
            </button>
        </form>
    </div>
</div>

<header class="header">
    <div class="container nav">
        <a class="brand" href="{% url 'home' %}">
            <img class="brand-logo-img"
                 src="{% static 'baatap-logo.png' %}"
                 alt="BaaTap KG">
            <span>
                BaaTap<span class="brand-kg"> KG</span>
                <small>Деловые связи Кыргызстана</small>
            </span>
        </a>

        <button class="mobile-menu"
                type="button"
                onclick="document.querySelector('.nav-links').classList.toggle('open')"
                aria-label="Открыть меню"
                aria-expanded="false">
            ☰
        </button>

        <div class="nav-links">
            <a href="{% url 'home' %}">Главная</a>
            <a href="{% url 'request_list' %}">Запросы покупателей</a>
            <a href="{% url 'supplier_listing_list' %}">Товары и услуги поставщиков</a>

            {% if user.is_authenticated %}
                <a href="{% url 'dashboard' %}">Личный кабинет</a>
                <a href="{% url 'profile_edit' %}">Профиль</a>

                {% if user.role == "buyer" or user.role == "both" or user.is_staff %}
                    <a href="{% url 'request_create' %}">Создать запрос</a>
                {% endif %}

                {% if user.role == "supplier" or user.role == "both" or user.is_staff %}
                    <a href="{% url 'supplier_listing_create' %}">Разместить предложение</a>
                {% endif %}

                <form method="post" action="{% url 'logout' %}" class="inline-form">
                    {% csrf_token %}
                    <button class="nav-logout" type="submit">Выйти</button>
                </form>
            {% else %}
                <a href="{% url 'login' %}">Войти</a>
                <a class="btn btn-primary btn-small" href="{% url 'register' %}">Регистрация</a>
            {% endif %}
        </div>
    </div>
</header>

<main>
    {% if messages %}
        <div class="container messages">
            {% for message in messages %}
                <div class="message {{ message.tags }}">{{ message }}</div>
            {% endfor %}
        </div>
    {% endif %}

    {% block content %}{% endblock %}
</main>

<footer class="footer">
    <div class="container footer-inner">

        <a class="brand footer-brand" href="{% url 'home' %}">
            <img class="brand-logo-img"
                 src="{% static 'baatap-logo.png' %}"
                 alt="BaaTap KG">

            <span>
                BaaTap<span class="brand-kg"> KG</span>
                <small>Деловые связи Кыргызстана</small>
            </span>
        </a>

        <p>
            {% if request.LANGUAGE_CODE == 'ky' %}
                Жеке компаниялар үчүн коммерциялык сунуштарды издөө кызматы.
            {% else %}
                Сервис поиска коммерческих предложений для частных компаний.
            {% endif %}
        </p>

        <span>© {% now "Y" %} BaaTap KG</span>

    </div>



<nav class="legal-links" aria-label="Legal">
  <a href="{% url 'privacy' %}">{% if request.LANGUAGE_CODE == 'ky' %}&#1050;&#1091;&#1087;&#1091;&#1103;&#1083;&#1099;&#1082; &#1089;&#1072;&#1103;&#1089;&#1072;&#1090;&#1099;{% else %}&#1055;&#1086;&#1083;&#1080;&#1090;&#1080;&#1082;&#1072; &#1082;&#1086;&#1085;&#1092;&#1080;&#1076;&#1077;&#1085;&#1094;&#1080;&#1072;&#1083;&#1100;&#1085;&#1086;&#1089;&#1090;&#1080;{% endif %}</a>
  <span aria-hidden="true"> | </span>
  <a href="{% url 'terms' %}">{% if request.LANGUAGE_CODE == 'ky' %}&#1050;&#1086;&#1083;&#1076;&#1086;&#1085;&#1091;&#1091;&#1095;&#1091; &#1082;&#1077;&#1083;&#1080;&#1096;&#1080;&#1084;&#1080;{% else %}&#1055;&#1086;&#1083;&#1100;&#1079;&#1086;&#1074;&#1072;&#1090;&#1077;&#1083;&#1100;&#1089;&#1082;&#1086;&#1077; &#1089;&#1086;&#1075;&#1083;&#1072;&#1096;&#1077;&#1085;&#1080;&#1077;{% endif %}</a>
</nav>
</footer>

</body>
</html>

